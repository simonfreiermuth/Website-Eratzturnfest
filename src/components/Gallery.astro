---
import { getImage } from "astro:assets";

// All event photos live in src/assets/event_photos. They are imported at
// build time via import.meta.glob so new photos appear in the gallery just
// by dropping the file into that folder — no code change needed.
const modules = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/event_photos/*.{jpg,jpeg,png,webp,avif,JPG,JPEG,PNG,WEBP,AVIF}",
  { eager: true },
);

const sources = Object.entries(modules)
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([, mod]) => mod.default);

// Two optimised sizes per photo: a small WebP thumbnail for the grid (lazy
// loaded, so only on-screen images are fetched) and a larger one for the
// full-screen lightbox view.
const photos = await Promise.all(
  sources.map(async (src) => {
    const [thumb, full] = await Promise.all([
      getImage({ src, width: 600, format: "webp", quality: 60 }),
      getImage({ src, width: 1800, format: "webp", quality: 72 }),
    ]);
    return {
      thumb: thumb.src,
      full: full.src,
      width: src.width,
      height: src.height,
    };
  }),
);
---

<section class="section section--surface" id="galerie">
  <div class="section__inner">
    <div class="gallery__head">
      <header class="section-heading">
        <span class="eyebrow">Rückblick</span>
        <h2 class="section-heading__title">Galerie</h2>
      </header>

      <a
        class="gallery__credit"
        href="https://www.instagram.com/roman_nietlispach/"
        target="_blank"
        rel="noopener noreferrer"
      >
        <span class="material-symbols-outlined gallery__credit-icon" aria-hidden="true">photo_camera</span>
        <span class="gallery__credit-text">
          <span class="gallery__credit-label">Fotos von</span>
          <strong class="gallery__credit-name">Roman Nietlispach</strong>
          <span class="gallery__credit-handle">@roman_nietlispach</span>
        </span>
        <span class="material-symbols-outlined gallery__credit-arrow" aria-hidden="true">open_in_new</span>
      </a>
    </div>

    {
      photos.length === 0 ? (
        <p class="gallery__empty">Die Fotos folgen in Kürze.</p>
      ) : (
        <ul class="gallery__grid">
          {photos.map((p, i) => (
            <li class="gallery__item">
              <button
                class="gallery__btn"
                type="button"
                data-full={p.full}
                aria-label={`Foto ${i + 1} vergrössern`}
              >
                <img
                  src={p.thumb}
                  alt={`Turnfest 2026 — Foto ${i + 1}`}
                  width={p.width}
                  height={p.height}
                  loading="lazy"
                  decoding="async"
                />
              </button>
            </li>
          ))}
        </ul>
      )
    }
  </div>

  {/* Lightbox — full-screen overlay opened via showModal(); plain <dialog>,
      no dependency. Prev/next + keyboard navigation. */}
  <dialog class="gallery__lightbox" id="gallery-lightbox" aria-label="Foto-Vorschau">
    <div class="gallery__stage">
      <img id="gallery-lightbox-img" src="" alt="" decoding="async" />
    </div>

    <button class="gallery__nav gallery__nav--prev" id="gallery-prev" aria-label="Vorheriges Foto" type="button">
      <span class="material-symbols-outlined" aria-hidden="true">chevron_left</span>
    </button>
    <button class="gallery__nav gallery__nav--next" id="gallery-next" aria-label="Nächstes Foto" type="button">
      <span class="material-symbols-outlined" aria-hidden="true">chevron_right</span>
    </button>
    <button class="gallery__close" id="gallery-close" aria-label="Schliessen" type="button">
      <span class="material-symbols-outlined" aria-hidden="true">close</span>
    </button>
    <span class="gallery__counter" id="gallery-counter" aria-hidden="true"></span>
  </dialog>
</section>

<script>
  const dialog = document.getElementById("gallery-lightbox") as HTMLDialogElement | null;
  const img = document.getElementById("gallery-lightbox-img") as HTMLImageElement | null;
  const stage = dialog?.querySelector<HTMLElement>(".gallery__stage") ?? null;
  const counter = document.getElementById("gallery-counter");
  const prevBtn = document.getElementById("gallery-prev");
  const nextBtn = document.getElementById("gallery-next");
  const buttons = Array.from(
    document.querySelectorAll<HTMLButtonElement>(".gallery__btn"),
  );

  if (dialog && img && buttons.length > 0) {
    const items = buttons.map((b, i) => ({
      full: b.dataset.full ?? "",
      alt: `Turnfest 2026 — Foto ${i + 1}`,
    }));
    const single = items.length < 2;
    prevBtn?.toggleAttribute("hidden", single);
    nextBtn?.toggleAttribute("hidden", single);

    let index = 0;

    // Warm the browser cache for the neighbouring images so prev/next feel
    // instant without eagerly loading the whole gallery up front.
    const preload = (i: number) => {
      const src = items[(i + items.length) % items.length]?.full;
      if (src) new Image().src = src;
    };

    const render = () => {
      const item = items[index];
      img.src = item.full;
      img.alt = item.alt;
      if (counter) counter.textContent = `${index + 1} / ${items.length}`;
      preload(index + 1);
      preload(index - 1);
    };

    const open = (i: number) => {
      index = i;
      render();
      dialog.showModal();
    };
    const go = (delta: number) => {
      index = (index + delta + items.length) % items.length;
      render();
    };
    const close = () => {
      dialog.close();
      img.src = "";
    };

    buttons.forEach((btn, i) => btn.addEventListener("click", () => open(i)));
    prevBtn?.addEventListener("click", () => go(-1));
    nextBtn?.addEventListener("click", () => go(1));
    document.getElementById("gallery-close")?.addEventListener("click", close);

    // Click on the dim backdrop (dialog or stage padding, not the image) closes.
    dialog.addEventListener("click", (e) => {
      if (e.target === dialog || e.target === stage) close();
    });

    dialog.addEventListener("keydown", (e) => {
      if (single) return;
      if (e.key === "ArrowLeft") {
        e.preventDefault();
        go(-1);
      } else if (e.key === "ArrowRight") {
        e.preventDefault();
        go(1);
      }
    });
  }
</script>

<style>
  /* Heading and photo credit share one row (wrap on narrow screens). */
  .gallery__head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-4) var(--space-6);
    margin-bottom: var(--space-7);
  }

  .gallery__head .section-heading {
    margin-bottom: 0;
  }

  /* Prominent photographer shout-out / link. */
  .gallery__credit {
    display: inline-flex;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-3) var(--space-5);
    background: var(--color-primary);
    color: var(--color-on-primary);
    border-radius: var(--radius-pill);
    text-decoration: none;
    box-shadow: var(--shadow-soft);
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }

  .gallery__credit:hover,
  .gallery__credit:focus-visible {
    transform: translateY(-2px);
    box-shadow: var(--shadow-lift);
    outline: none;
  }

  .gallery__credit:focus-visible {
    outline: 3px solid var(--color-accent);
    outline-offset: 2px;
  }

  .gallery__credit-icon {
    font-size: 1.8rem;
    color: var(--color-accent);
    flex-shrink: 0;
  }

  .gallery__credit-text {
    display: flex;
    flex-direction: column;
    line-height: 1.2;
  }

  .gallery__credit-label {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    opacity: 0.8;
  }

  .gallery__credit-name {
    font-family: var(--font-display);
    font-weight: 900;
    font-style: italic;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    font-size: 1.25rem;
  }

  .gallery__credit-handle {
    font-size: 0.85rem;
    color: var(--color-accent);
  }

  .gallery__credit-arrow {
    font-size: 1.2rem;
    opacity: 0.7;
    flex-shrink: 0;
  }

  .gallery__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
    gap: var(--space-3);
  }

  @media (min-width: 560px) {
    .gallery__grid {
      grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
      gap: var(--space-4);
    }
  }

  .gallery__item {
    margin: 0;
  }

  .gallery__btn {
    display: block;
    width: 100%;
    padding: 0;
    border: none;
    background: var(--color-muted);
    border-radius: var(--radius-md);
    overflow: hidden;
    cursor: pointer;
    box-shadow: var(--shadow-soft);
    aspect-ratio: 4 / 3;
    transition: transform 0.3s cubic-bezier(0.2, 0.7, 0.2, 1),
                box-shadow 0.3s ease;
  }

  .gallery__btn img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .gallery__btn:hover,
  .gallery__btn:focus-visible {
    transform: translateY(-3px) scale(1.02);
    box-shadow: var(--shadow-lift);
    outline: none;
  }

  .gallery__btn:focus-visible {
    outline: 3px solid var(--color-accent);
    outline-offset: 2px;
  }

  .gallery__empty {
    color: var(--color-ink-soft);
    font-size: 1.1rem;
  }

  /* ── Lightbox ─────────────────────────────────────────────────────────── */
  /* Full-screen overlay: the dialog fills the viewport so the nav/close
     controls have a stable box to anchor to (an auto-sized dialog does not). */
  .gallery__lightbox {
    width: 100%;
    height: 100%;
    max-width: 100%;
    max-height: 100%;
    margin: 0;
    padding: 0;
    border: none;
    background: transparent;
    overflow: hidden;
  }

  .gallery__lightbox[open] {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .gallery__lightbox::backdrop {
    background: rgba(0, 0, 0, 0.9);
    backdrop-filter: blur(2px);
  }

  .gallery__stage {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    padding: var(--space-5);
  }

  .gallery__lightbox img {
    display: block;
    max-width: min(94vw, 1600px);
    max-height: 88vh;
    width: auto;
    height: auto;
    border-radius: var(--radius-md);
    box-shadow: 0 16px 50px rgba(0, 0, 0, 0.5);
  }

  /* Shared round control button (prev / next / close). */
  .gallery__nav,
  .gallery__close {
    position: fixed;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.8rem;
    height: 2.8rem;
    background: rgba(255, 255, 255, 0.92);
    color: var(--color-primary);
    border: none;
    border-radius: 50%;
    cursor: pointer;
    box-shadow: var(--shadow-lift);
    transition: background 0.15s ease, transform 0.15s ease;
  }

  .gallery__nav:hover,
  .gallery__close:hover {
    background: #fff;
    transform: scale(1.06);
  }

  .gallery__nav .material-symbols-outlined,
  .gallery__close .material-symbols-outlined {
    font-size: 1.6rem;
  }

  .gallery__close {
    top: clamp(8px, 2vw, 20px);
    right: clamp(8px, 2vw, 20px);
  }

  .gallery__nav {
    top: 50%;
    transform: translateY(-50%);
  }

  .gallery__nav:hover {
    transform: translateY(-50%) scale(1.06);
  }

  .gallery__nav--prev {
    left: clamp(8px, 2vw, 24px);
  }

  .gallery__nav--next {
    right: clamp(8px, 2vw, 24px);
  }

  .gallery__counter {
    position: fixed;
    bottom: clamp(10px, 2.5vw, 24px);
    left: 50%;
    transform: translateX(-50%);
    padding: var(--space-1) var(--space-4);
    background: rgba(0, 0, 0, 0.45);
    color: #fff;
    border-radius: var(--radius-pill);
    font-family: var(--font-display);
    font-weight: 700;
    font-style: italic;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.04em;
    font-size: 0.9rem;
  }
</style>
