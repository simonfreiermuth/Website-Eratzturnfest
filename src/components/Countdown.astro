---
import { event } from "../data/event";
---

<div class="countdown" data-target={event.date} aria-live="polite">
  <span class="countdown__label">Noch</span>
  <span class="countdown__cell">
    <span class="countdown__num" data-cd="days">—</span>
    <span class="countdown__unit">Tage</span>
  </span>
  <span class="countdown__sep">·</span>
  <span class="countdown__cell">
    <span class="countdown__num" data-cd="hours">—</span>
    <span class="countdown__unit">Std</span>
  </span>
  <span class="countdown__sep">·</span>
  <span class="countdown__cell">
    <span class="countdown__num" data-cd="minutes">—</span>
    <span class="countdown__unit">Min</span>
  </span>
</div>

<style>
  .countdown {
    display: inline-flex;
    align-items: baseline;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-5);
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: var(--radius-pill);
    color: var(--color-on-primary);
    font-family: var(--font-display);
    font-style: italic;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    backdrop-filter: blur(4px);
  }

  .countdown__label {
    font-weight: 700;
    font-size: 0.85rem;
    color: var(--color-accent);
  }

  .countdown__cell {
    display: inline-flex;
    align-items: baseline;
    gap: var(--space-1);
  }

  .countdown__num {
    font-weight: 900;
    font-size: 1.3rem;
    color: var(--color-on-primary);
    font-variant-numeric: tabular-nums;
  }

  .countdown__unit {
    font-weight: 700;
    font-size: 0.8rem;
    opacity: 0.85;
  }

  .countdown__sep {
    color: var(--color-accent);
    font-weight: 900;
  }

  .countdown[data-finished="true"] .countdown__label::before {
    content: "Es ist soweit — ";
  }
</style>

<script>
  function tick() {
    const root = document.querySelector<HTMLElement>(".countdown");
    if (!root) return;
    const target = new Date(root.dataset.target!).getTime();
    const now = Date.now();
    const diff = Math.max(0, target - now);

    const days = Math.floor(diff / 86_400_000);
    const hours = Math.floor((diff % 86_400_000) / 3_600_000);
    const minutes = Math.floor((diff % 3_600_000) / 60_000);

    const set = (key: string, value: number) => {
      const el = root.querySelector<HTMLElement>(`[data-cd="${key}"]`);
      if (el) el.textContent = String(value);
    };
    set("days", days);
    set("hours", hours);
    set("minutes", minutes);

    if (diff === 0) root.dataset.finished = "true";
  }

  tick();
  setInterval(tick, 30_000);
</script>
