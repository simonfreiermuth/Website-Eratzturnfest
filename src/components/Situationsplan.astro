---
import fs from "node:fs";
import path from "node:path";
import { stations, infoMarkers } from "../data/stations";

// Inline the lageplan so we can attach click handlers to the numbered
// markers and recolour them via CSS.
const lageplanRaw = fs
  .readFileSync(path.resolve("./public/images/lageplan.svg"), "utf-8")
  .replace(/\swidth="[^"]*"/, "")
  .replace(/\sheight="[^"]*"/, "");
---

<section class="section section--surface" id="situationsplan">
  <div class="section__inner situ">
    <header class="section-heading">
      <span class="eyebrow">Vor Ort</span>
      <h2 class="section-heading__title">Situationsplan</h2>
    </header>

    <div class="situ__grid">
      <div class="situ__legend-col">
        <ol class="situ__legend" aria-label="Stationen und Infrastruktur">
          {stations.map((s) => (
            <li class="situ__legend-item" data-station={String(s.nr)} tabindex="0" role="button" aria-pressed="false">
              <span class="badge-nr">{s.nr}</span>
              <span class="situ__legend-name">{s.name}</span>
            </li>
          ))}
          {infoMarkers.map((m) => (
            <li
              class="situ__legend-item situ__legend-item--info"
              data-station={m.kind}
              tabindex="0"
              role="button"
              aria-pressed="false"
            >
              <span class={`badge-info badge-info--${m.kind}`} aria-hidden="true">{m.symbol}</span>
              <span class="situ__legend-name">{m.name}</span>
            </li>
          ))}
        </ol>

        <div class="situ__gps">
          <button class="situ__gps-toggle" id="gps-toggle" aria-pressed="false" aria-label="Eigenen Standort auf der Karte anzeigen">
            <span class="badge-info badge-info--gps" aria-hidden="true">
              <span class="material-symbols-outlined">location_searching</span>
            </span>
            <span class="situ__legend-name">Mein Standort</span>
          </button>
          <p class="situ__gps-status" id="gps-status" hidden>
            Standort wird bestimmt …
          </p>
        </div>
      </div>

      <figure class="situ__figure">
        <div class="situ__svg" set:html={lageplanRaw}></div>
        <figcaption class="situ__caption">
          Sportanlage Brugglismatt, Zeiningen — Stationsnummern antippen
        </figcaption>
      </figure>
    </div>
  </div>
</section>

<script>
  const root = document.querySelector<HTMLElement>(".situ");
  if (root) {
    const legendItems = Array.from(
      root.querySelectorAll<HTMLLIElement>(".situ__legend-item"),
    );
    const svg = root.querySelector<SVGElement>(".situ__svg svg");

    function tagMarker(marker: Element | null | undefined, key: string, label: string) {
      if (!marker || marker.tagName.toLowerCase() !== "g") return;
      marker.setAttribute("data-station", key);
      marker.classList.add("station-marker");
      marker.setAttribute("tabindex", "0");
      marker.setAttribute("role", "button");
      marker.setAttribute("aria-label", label);
      marker.addEventListener("click", () => setActive(key));
      marker.addEventListener("keydown", (e) => {
        const ke = e as KeyboardEvent;
        if (ke.key === "Enter" || ke.key === " ") {
          ke.preventDefault();
          setActive(key);
        }
      });
    }

    if (svg) {
      // Numbered stations + WC + P all have the same nesting:
      //   <g> (marker) > <g> (text wrapper) > <text>
      // so the marker is exactly two ancestors above the text.
      svg.querySelectorAll<SVGTextElement>("text").forEach((text) => {
        const content = (text.textContent ?? "").trim();
        let key: string | null = null;
        let label = "";
        if (/^[1-8]$/.test(content)) {
          key = content;
          label = `Station ${content}`;
        } else if (content === "WC") {
          key = "wc";
          label = "Toiletten";
        } else if (content === "P") {
          key = "parking";
          label = "Parkplatz";
        }
        if (!key) return;
        tagMarker(text.parentElement?.parentElement, key, label);
      });

      // Sanität has an extra wrapper <g> around image/circle/cross:
      //   <g> (marker) > <g> (wrapper) > <g> (rect wrapper) > <rect>
      // so the marker is three ancestors above the red rect.
      const redRect = svg.querySelector<SVGRectElement>('rect[style*="rgb(255,31,72)"]');
      if (redRect) {
        tagMarker(
          redRect.parentElement?.parentElement?.parentElement,
          "medical",
          "Sanität",
        );
      }
    }

    legendItems.forEach((li) => {
      const key = li.dataset.station;
      if (!key) return;
      li.addEventListener("click", () => setActive(key));
      li.addEventListener("keydown", (e) => {
        if (e.key === "Enter" || e.key === " ") {
          e.preventDefault();
          setActive(key);
        }
      });
    });

    let active: string | null = null;
    function setActive(key: string) {
      const next = active === key ? null : key;
      active = next;
      legendItems.forEach((li) => {
        const on = li.dataset.station === active;
        li.classList.toggle("is-active", on);
        li.setAttribute("aria-pressed", on ? "true" : "false");
      });
      // WC has two map markers — querySelectorAll handles the 1-to-N mapping.
      svg?.querySelectorAll<SVGGElement>(".station-marker").forEach((m) => {
        m.classList.toggle("is-active", m.getAttribute("data-station") === active);
      });
    }

    // ── GPS ──────────────────────────────────────────────────────────────────
    // Two geographic reference corners that anchor the SVG coordinate space.
    // top-left: top light-grey building corner
    // bot-right: bottom-right corner of the red running track
    // const GPS_TL = { lat: 47.544404413562766, lng: 7.867954380395259 };
    // const GPS_BR = { lat: 47.543694695060914, lng: 7.870471307339379 };
    const GPS_TL = { lat: 47.544487746490155, lng: 7.867735388934311 };
    const GPS_BR = { lat: 47.54350729567280, lng: 7.870819761630830 };
    const SVG_W = 2481;
    const SVG_H = 3508;

    function geoToSvg(lat: number, lng: number) {
      return {
        x: ((lng - GPS_TL.lng) / (GPS_BR.lng - GPS_TL.lng)) * SVG_W,
        // SVG Y increases downward; latitude increases upward → invert
        y: ((GPS_TL.lat - lat) / (GPS_TL.lat - GPS_BR.lat)) * SVG_H,
      };
    }

    function inBounds(lat: number, lng: number) {
      return (
        lat >= GPS_BR.lat && lat <= GPS_TL.lat &&
        lng >= GPS_TL.lng && lng <= GPS_BR.lng
      );
    }

    const gpsBtn = root.querySelector<HTMLButtonElement>("#gps-toggle");
    const gpsStatus = root.querySelector<HTMLParagraphElement>("#gps-status");

    function setGpsStatus(msg: string) {
      if (!gpsStatus) return;
      if (msg) {
        gpsStatus.textContent = msg;
        gpsStatus.removeAttribute("hidden");
      } else {
        gpsStatus.setAttribute("hidden", "");
      }
    }

    function setGpsIcon(state: "off" | "searching" | "on" | "outside") {
      if (!gpsBtn) return;
      const iconEl = gpsBtn.querySelector(".material-symbols-outlined");
      if (iconEl) {
        const icons = {
          off:      "location_searching",
          searching:"location_searching",
          on:       "my_location",
          outside:  "location_off",
        } as const;
        iconEl.textContent = icons[state];
      }
      gpsBtn.classList.toggle("is-searching", state === "searching");
      gpsBtn.classList.toggle("is-enabled", state !== "off");
    }

    function updateLocationMarker(lat: number, lng: number) {
      const svgEl = root.querySelector<SVGSVGElement>(".situ__svg svg");
      if (!svgEl) return;
      let marker = svgEl.querySelector<SVGGElement>("#gps-marker");

      if (!marker) {
        const NS = "http://www.w3.org/2000/svg";
        marker = document.createElementNS(NS, "g") as SVGGElement;
        marker.setAttribute("id", "gps-marker");
        marker.setAttribute("role", "img");
        marker.setAttribute("aria-label", "Dein Standort");

        const pulse = document.createElementNS(NS, "circle");
        pulse.setAttribute("r", "50");
        pulse.setAttribute("class", "gps-pulse");

        const dot = document.createElementNS(NS, "circle");
        dot.setAttribute("r", "28");
        dot.setAttribute("class", "gps-dot");
        dot.setAttribute("stroke", "white");
        dot.setAttribute("stroke-width", "10");

        marker.appendChild(pulse);
        marker.appendChild(dot);
        svgEl.appendChild(marker);
      }

      const { x, y } = geoToSvg(lat, lng);
      marker.setAttribute("transform", `translate(${x.toFixed(1)}, ${y.toFixed(1)})`);

      if (inBounds(lat, lng)) {
        marker.removeAttribute("hidden");
        setGpsStatus("");
        setGpsIcon("on");
      } else {
        marker.setAttribute("hidden", "");
        setGpsStatus("Du bist ausserhalb des Geländes");
        setGpsIcon("outside");
      }
    }

    function removeLocationMarker() {
      root.querySelector(".situ__svg svg")?.querySelector("#gps-marker")?.remove();
    }

    let watchId: number | null = null;

    function stopGps() {
      if (watchId !== null) {
        navigator.geolocation.clearWatch(watchId);
        watchId = null;
      }
      removeLocationMarker();
      setGpsStatus("");
      setGpsIcon("off");
      gpsBtn?.setAttribute("aria-pressed", "false");
    }

    function startGps() {
      if (!navigator.geolocation) {
        setGpsStatus("GPS nicht verfügbar");
        return;
      }
      setGpsIcon("searching");
      setGpsStatus("Standort wird bestimmt …");
      gpsBtn?.setAttribute("aria-pressed", "true");

      watchId = navigator.geolocation.watchPosition(
        (pos) => updateLocationMarker(pos.coords.latitude, pos.coords.longitude),
        (err) => {
          // Only abort for a hard denial; transient errors (TIMEOUT,
          // POSITION_UNAVAILABLE) leave the watch running so the dot
          // updates again as soon as a fix is available.
          if (err.code === 1 /* PERMISSION_DENIED */) {
            stopGps();
            setGpsStatus("GPS nicht verfügbar");
          }
        },
        { enableHighAccuracy: true, maximumAge: 5000 },
      );
    }

    gpsBtn?.addEventListener("click", () => {
      if (watchId === null) startGps();
    });
    gpsBtn?.addEventListener("keydown", (e) => {
      if (e.key === "Enter" || e.key === " ") { e.preventDefault(); gpsBtn.click(); }
    });
  }
</script>

<style>
  .situ__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-7);
    align-items: start;
  }

  @media (min-width: 760px) {
    .situ__grid {
      grid-template-columns: 0.9fr 1.1fr;
    }
  }

  .situ__legend {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .situ__legend-item {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-3) var(--space-4);
    background: var(--color-muted);
    border-radius: var(--radius-md);
    cursor: pointer;
    transition: background 0.2s ease, transform 0.2s ease;
    user-select: none;
  }

  .situ__legend-item:hover {
    background: #dbe5f3;
  }

  .situ__legend-item:focus-visible {
    outline: 3px solid var(--color-accent);
    outline-offset: 2px;
  }

  .situ__legend-item.is-active {
    background: var(--color-primary);
    transform: translateX(4px);
  }

  .situ__legend-item.is-active .situ__legend-name {
    color: var(--color-on-primary);
  }

  .situ__legend-item.is-active .badge-nr {
    background: var(--color-accent);
    box-shadow: 0 0 0 3px rgba(255, 255, 255, 0.7);
  }

  .situ__legend-name {
    font-family: var(--font-display);
    font-weight: 700;
    font-style: italic;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-primary);
    font-size: 1rem;
    transition: color 0.2s ease;
  }

  /* Visual gap before the infrastructure group. */
  .situ__legend-item:not(.situ__legend-item--info) + .situ__legend-item--info {
    margin-top: var(--space-3);
  }

  /* GPS opt-in section — sits below the legend list, same column. */
  .situ__gps {
    margin-top: var(--space-4);
  }

  .situ__gps-toggle {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-3) var(--space-4);
    width: 100%;
    background: var(--color-muted);
    border: none;
    border-radius: var(--radius-md);
    cursor: pointer;
    transition: background 0.2s ease, transform 0.2s ease;
    text-align: left;
    user-select: none;
  }

  .situ__gps-toggle:hover {
    background: #dbe5f3;
  }

  .situ__gps-toggle:focus-visible {
    outline: 3px solid var(--color-accent);
    outline-offset: 2px;
  }

  /* Badge is muted until GPS is activated; only the badge changes, never the button background. */
  .badge-info--gps {
    background: #9eaec5;
    color: var(--color-on-primary);
    font-size: 1.1rem;
  }

  .situ__gps-toggle.is-enabled .badge-info--gps {
    background: #e53935;
  }

  /* Slow spin while awaiting the first geolocation fix. */
  .situ__gps-toggle.is-searching .material-symbols-outlined {
    animation: gps-spin 1.5s linear infinite;
    display: inline-block;
  }

  @keyframes gps-spin {
    to { transform: rotate(360deg); }
  }

  .situ__gps-status {
    margin: var(--space-2) 0 0 var(--space-4);
    font-size: 0.85rem;
    color: var(--color-ink);
    font-family: var(--font-body);
  }

  .badge-info {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    flex-shrink: 0;
    font-family: var(--font-display);
    font-weight: 900;
    line-height: 1;
  }

  .badge-info--medical {
    background: var(--color-surface);
    color: #dc2626;
    border: 2px solid #dc2626;
    font-size: 1.5rem;
    font-style: normal;
    padding-bottom: 2px;
  }

  .badge-info--wc {
    background: var(--color-accent);
    color: var(--color-on-primary);
    font-size: 0.78rem;
    font-style: normal;
    letter-spacing: 0.02em;
  }

  .badge-info--parking {
    background: var(--color-primary);
    color: var(--color-on-primary);
    font-size: 1.125rem;
    font-style: italic;
  }

  .situ__figure {
    margin: 0;
  }

  .situ__svg {
    width: 100%;
  }

  .situ__svg :global(svg) {
    width: 100%;
    height: auto;
    display: block;
    border-radius: var(--radius-md);
  }

  /* Marker interactivity. The classes are applied via JS to nodes
     inside the inlined SVG, so use :global() to escape Astro scoping. */
  .situ__svg :global(.station-marker) {
    cursor: pointer;
    outline: none;
  }

  .situ__svg :global(.station-marker circle) {
    transition: stroke-width 0.18s ease, fill 0.18s ease, filter 0.18s ease;
    stroke: transparent;
    stroke-width: 0;
  }

  .situ__svg :global(.station-marker:hover circle),
  .situ__svg :global(.station-marker:focus-visible circle) {
    stroke: #ffffff;
    stroke-width: 5;
  }

  /* Active marker: solid brand blue (matches the legend's active state).
     !important is required to override the inline `style="fill:rgb(...)"`
     baked into the source SVG. */
  .situ__svg :global(.station-marker.is-active circle) {
    fill: var(--color-primary) !important;
    stroke: #ffffff;
    stroke-width: 7;
    filter: drop-shadow(0 0 10px rgba(0, 0, 0, 0.35));
  }

  /* Sanität marker keeps its white circle + red cross — only the stroke
     turns blue so the red cross stays visible. */
  .situ__svg :global(.station-marker[data-station="medical"].is-active circle) {
    fill: #ffffff !important;
    stroke: var(--color-primary);
    stroke-width: 5;
  }

  /* GPS location marker — injected into the SVG by JS. */
  .situ__svg :global(#gps-marker .gps-dot) {
    fill: #e53935;
  }

  .situ__svg :global(#gps-marker .gps-pulse) {
    fill: rgba(229, 57, 53, 0.35);
    animation: gps-pulse 2s ease-out infinite;
  }

  @keyframes gps-pulse {
    0%   { r: 30; opacity: 0.6; }
    100% { r: 90; opacity: 0;   }
  }

  .situ__caption {
    margin-top: var(--space-2);
    font-size: 0.9rem;
    color: var(--color-ink-soft);
    text-align: center;
  }

  @media (min-width: 760px) {
    .situ__grid > .situ__figure {
      order: 2;
    }
    .situ__grid > .situ__legend-col {
      order: 1;
    }
  }
</style>
