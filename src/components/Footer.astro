---
import { getImage } from "astro:assets";
import grungeSrc from "../assets/grunge.jpg";
import { organisations } from "../data/organisations";

const base = import.meta.env.BASE_URL;

const grunge = await getImage({
  src: grungeSrc,
  width: 1600,
  format: "webp",
  quality: 55,
});
---

<footer class="site-footer" style={`--grunge-url: url("${grunge.src}");`}>
  <div class="site-footer__bg" aria-hidden="true"></div>

  <div class="site-footer__inner">
    <p class="site-footer__eyebrow">Veranstaltet von</p>
    <ul class="site-footer__clubs" aria-label="Veranstaltende Vereine">
      {organisations.map((o) => (
        <li>
          <a
            class={`site-footer__card${o.invert ? " site-footer__card--invert" : ""}`}
            href={o.url}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`Website ${o.name}`}
          >
            <img src={`${base}images/clubs/${o.logo}`} alt={o.name} loading="lazy" decoding="async" />
          </a>
        </li>
      ))}
    </ul>

    <p class="site-footer__legal">
      <a href="#top">Nach oben</a>
    </p>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    overflow: hidden;
    background: var(--color-primary);
    color: var(--color-on-primary);
    padding: var(--space-8) var(--space-5);
  }

  .site-footer__bg {
    position: absolute;
    inset: 0;
    background: var(--grunge-url) center/cover no-repeat;
    mix-blend-mode: overlay;
    opacity: 0.45;
    pointer-events: none;
  }

  .site-footer__inner {
    position: relative;
    max-width: var(--max-content);
    margin-inline: auto;
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .site-footer__eyebrow {
    font-family: var(--font-display);
    font-weight: 700;
    font-style: italic;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-accent);
    font-size: 0.95rem;
  }

  .site-footer__clubs {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-5);
    justify-content: center;
  }

  .site-footer__card {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 13rem;
    height: 9rem;
    padding: var(--space-4);
    background: var(--color-surface);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-soft);
    text-decoration: none;
    transition: transform 0.18s ease, box-shadow 0.18s ease;
  }

  .site-footer__card:hover,
  .site-footer__card:focus-visible {
    transform: translateY(-3px);
    box-shadow: var(--shadow-lift);
  }

  .site-footer__card:focus-visible {
    outline: 3px solid var(--color-accent);
    outline-offset: 3px;
  }

  .site-footer__card img {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
  }

  /* The TVZ wordmark ships as white-on-transparent. Inverting it
     produces dark strokes on the white card. */
  .site-footer__card--invert img {
    filter: invert(1);
  }

  .site-footer__legal {
    color: rgba(255, 255, 255, 0.85);
    font-size: 0.9rem;
  }

  .site-footer__sep {
    margin-inline: var(--space-2);
    color: var(--color-accent);
  }

  .site-footer__legal a {
    color: var(--color-on-primary);
    text-decoration-color: var(--color-accent);
  }
</style>
